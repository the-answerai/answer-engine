# Answer Engine OSS — local-first defaults
NODE_ENV=development
HOST=127.0.0.1
PORT=5050

# PostgreSQL / pgvector
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_NAME=answerengine
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_POOL_MAX=10

# The local bootstrap pins every request and query to this tenant.
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# LM Studio is the default model route. Discover exact IDs with:
# curl --fail --silent http://127.0.0.1:1234/v1/models
LLM_PROVIDER=lmstudio
LLM_BASE_URL=http://127.0.0.1:1234/v1
MODELS_CHAT=replace-with-loaded-chat-model-id
MODELS_QA=replace-with-loaded-chat-model-id

EMBEDDING_PROVIDER=lmstudio
EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
MODELS_EMBEDDING=replace-with-loaded-embedding-model-id
EMBEDDING_DIMENSION=768

# Optional OpenAI-compatible provider credentials. Keep secrets in .env only.
# LLM_API_KEY=
# EMBEDDING_API_KEY=
# OPENAI_API_KEY=

LOG_LEVEL=info
