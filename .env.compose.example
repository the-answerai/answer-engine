# Runtime image (release default)
ANSWER_ENGINE_IMAGE=ghcr.io/the-answerai/answer-engine:1.1.0
ANSWER_ENGINE_PULL_POLICY=missing

# Loopback-only host ports
ANSWER_ENGINE_PORT=5050
DATABASE_PORT_HOST=5433
REDIS_PORT_HOST=6380

# Container runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=5000
BASE_URL=http://localhost:5050
AUTH_MODE=api_key
LOCAL_UI_AUTO_AUTH=true
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# Private service network
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=answerengine
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TLS=false

# Schema and embeddings. Set before first start. Changing the width later
# requires a fresh database and re-embedding all content.
EMBEDDING_DIMENSION=768
EMBEDDING_PROVIDER=lmstudio
MODELS_EMBEDDING=replace-with-loaded-lm-studio-embedding-model-id
EMBEDDING_BASE_URL=http://host.docker.internal:1234/v1

# Chat model
LLM_PROVIDER=lmstudio
MODELS_CHAT=replace-with-loaded-lm-studio-model-id
LLM_BASE_URL=http://host.docker.internal:1234/v1

# Local data directories live in the persistent /data volume.
AE_HOME=/data
STORAGE_DRIVER=local
RERANK_ENABLED=false

# Optional. On first start without this value, init emits one ae_live_ key for
# the installer to capture and store in the private .env.compose file.
# ANSWER_ENGINE_API_KEY=ae_live_replace-with-a-locally-generated-secret
