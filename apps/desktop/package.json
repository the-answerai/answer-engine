{
  "name": "@answer-engine/desktop",
  "license": "Apache-2.0",
  "version": "1.1.2",
  "description": "Local desktop launcher for Answer Engine",
  "author": "The AnswerAI Contributors",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "clean:release": "node scripts/clean-release.mjs",
    "build": "pnpm clean && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "lint": "eslint \"src/**/*.{ts,cts}\"",
    "type-check": "tsc -p tsconfig.lint.json --noEmit",
    "test": "vitest run",
    "dev": "pnpm build && electron dist/main.js",
    "fixture": "pnpm build && AE_DESKTOP_FIXTURE=1 electron --remote-debugging-port=9228 dist/main.js",
    "package:dir": "pnpm build && electron-builder --dir --config electron-builder.yml",
    "package:mac": "pnpm build && electron-builder --mac --config electron-builder.yml",
    "package:win": "pnpm build && electron-builder --win --config electron-builder.yml",
    "checksums": "node scripts/checksums.mjs ../../tmp/desktop-release"
  },
  "dependencies": {
    "@answer-engine/create": "workspace:*",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.3.3",
    "vitest": "^3.2.6"
  }
}
